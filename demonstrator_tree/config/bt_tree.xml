<root BTCPP_format="4" >
 <BehaviorTree ID="MainTree">
    <Sequence name="magician_sequence">
        <Fallback>
            <IsRobotAtHome   name="check_home_pos"/>
            <CallHoming   name="call_homing_service"/>
        </Fallback>
        <CallOpcUaHomeBothActive   name="call_opcua_service_both"/>
        <RetryUntilSuccessful num_attempts="-1">
            <WaitOperator name="wait_operator_command"/>
        </RetryUntilSuccessful>
        <RetryUntilSuccessful num_attempts="-1">
        <Fallback>
            <Sequence name = "HumanWithRobotSequence">
                <IsFullAutomaticMode name = "automatic_mode"/>
            </Sequence>
           
            <Sequence name = "FullAutomaticModeSequence">
                <IsHumanRobotMode name = "cobot_mode"/>
                <RetryUntilSuccessful num_attempts="-1">
                    <WaitingForCarLocatedCellSensing name ="car_located_sensing_cell"/>
                </RetryUntilSuccessful>
                <CallOpcUaActiveSensing name="call_opc_sensing_active"/> 
                <CallCobotOperationSensing name="call_sensing_operation_service"/>

                   <RetryUntilSuccessful num_attempts="-1">
                     <WaitSensingOperationPos name="wait_sensing_reach_target"/>
                </RetryUntilSuccessful>

                <CallOpcUaDeactiveSensing name="call_opc_sensing_deactive"/>
                                
                    <RetryUntilSuccessful num_attempts="-1">
                        <WaitingOpcUaSensingDeactive name="wait_sensing_deactive_command"/>
                    </RetryUntilSuccessful>
                    <CallHoming name="call_homing_service_after_sensing"/>
                    <CallOpcUaFinishedSensingActive name="call_sensing_and_touchsensing_finished_active"/> 
                    <RetryUntilSuccessful num_attempts="-1">
                        <WaitingForCarLocatedCellCleaning name ="car_located_cleaning_cell"/>
                    </RetryUntilSuccessful>    
                   
                <CallOpcUaActiveCleaning name="call_opc_cleaning_active"/>                        
                <CallCobotOperationCleaning  name="call_cleaning_operation_service"/>

                <RetryUntilSuccessful num_attempts="-1">
                    <WaitCleaningOperationPos name="wait_cleaning_reach_target"/>
                    </RetryUntilSuccessful>
                <CallOpcUaDeactiveCleaning name="call_opc_cleaning_deactive"/>
 
                    <RetryUntilSuccessful num_attempts="-1">
                        <WaitingOpcUaCleaningDeactive name="wait_cleaning_deactive_command"/>
                    </RetryUntilSuccessful> 
                    <CallHoming name="call_homing_service_after_cleaning"/>
                    <CallOpcUaFinishedCleaningActive name="call_cleaning_finished_active"/>
                    <!-- <CallOpcUaAutomaticModeDeactive name="call_opcua_automatic_mode_deactive"/>  -->
                    <CallOpcUaCobotModeDeactive name="call_opcua_cobot_mode_deactive"/> 

                    <CallOpcUaFinishedSensingDeactive name="call_sensing_and_touchsensing_finished_deactive"/> 
                     <CallOpcUaFinishedCleaningDeactive name="call_cleaning_finished_deactive"/> 
                    <CallOpcUaHomeBothDeactive   name="call_opcua_service_both_deactive"/>
            </Sequence>
        </Fallback>
        </RetryUntilSuccessful>
    </Sequence>
 </BehaviorTree>
</root>
